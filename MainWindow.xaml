<Window x:Class="DiplomaWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiplomaWPF"
        mc:Ignorable="d"
        Title="TechStore"
        Height="502"
        Width="775"
        ResizeMode="CanMinimize">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0"
                     x:Name="ProductSearchBox"
                     Margin="10,4,10,4"
                     VerticalContentAlignment="Center"
                     TextChanged="ProductSearchBox_TextChanged"
            />
            <ListBox Grid.Row="1"
                x:Name="ProductsList"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="180"
                            Margin="10"
                            Padding="10"
                            Background="White"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="2"
                                              Opacity="0.3"/>
                        </Border.Effect>

                        <StackPanel>
                            <Image Height="100"
                                   Stretch="Uniform"
                                   Source="{Binding ImagePath}" />

                            <TextBlock Text="{Binding Name}"
                                       Margin="0,8,0,0"
                                       FontWeight="Bold"
                                       TextAlignment="Center"/>

                            <TextBlock Text="{Binding Price}"
                                       Margin="0,4,0,8"
                                       TextAlignment="Center"/>


                            <Button Content="До кошика"
                                    Tag="{Binding}"
                                    Click="AddToCart_Click"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    Padding="6"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

        <Border Grid.Column="1"
                Background="White"
                Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="-2"
                                  Opacity="0.2"/>
            </Border.Effect>


            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Кошик"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>


                    <Border Background="#F7F7F7"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Разом до оплати"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Margin="0,0,0,6"/>

                            <TextBlock x:Name="CartTotalText"
                                       FontSize="22"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="CartCountText"
                                       FontSize="12"
                                       Foreground="Gray"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Товари в кошику"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>


                    <Border Background="#FAFAFA"
                            Height="160"
                            CornerRadius="6"
                            Margin="0,0,0,10"
                            Padding="10">
                        <StackPanel>

                            <ListBox x:Name="CartItemsList"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Product.Name}"
                                                       FontSize="13"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Product.Price}"
                                                       FontWeight="Bold"
                                                       Margin="10,0,0,0"/>
                                            <StackPanel Orientation="Horizontal" Grid.Column="2">
                                                <Button Content="-" Click="DecreaseQuantity_Click"/>
                                                <TextBlock Text="{Binding Quantity}"/>
                                                <Button Content="+" Click="IncreaseQuantity_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="EmptyCartText"
                                       Text="Кошик порожній&#x0a;Додайте товари зліва"
                                       Foreground="Gray"
                                       TextAlignment="Center"
                                       Margin="10"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Очистити кошик"
                            Height="32"
                            Margin="0,0,0,10"
                            Background="#EEEEEE"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ClearCart_Click"/>


                    <Button Content="Оплатити"
                            Height="45"
                            Background="#2196F3"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Pay_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
