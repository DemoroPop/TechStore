<Window x:Class="DiplomaWPF.ProductDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiplomaWPF"
        mc:Ignorable="d"
        Title="ProductDetailsWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Source="{Binding ImagePath}">
            
        </Image>
        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Name}"></TextBlock>
            <TextBlock Text="{Binding Price}"></TextBlock>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"></TextBlock>

            <Button Content="Add to Cart"
                    Click="AddToCart_Click"/>
        </StackPanel>
    </Grid>
</Window>
